# Rename this file to terraform.tfvars and fill in your values

app_name    = "tutormvp"
environment = "prod"
location    = "eastus"

# Free tier is "F1", Basic tier with always-on is "B1"
app_service_sku = "B1"

# Supabase PostgreSQL connection
postgres_url = ""
supabase_url = ""
supabase_key = ""

# Azure OpenAI
azure_openai_endpoint        = ""
azure_openai_api_key         = ""
azure_openai_deployment_name = "gpt-6-sol"

# Leave empty to have Terraform generate a random secret key.
secret_key = ""

