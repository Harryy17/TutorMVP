# Deep Tutor — Environment Variables
# Copy this file to .env and fill in your values

# ─── NVIDIA NIM API ────────────────────────────────────────────────────────────
# Free tier: 1,000 API calls/month per model
# Get your key at: https://build.nvidia.com → Sign In → Get API Key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# ─── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ─── Storage Paths ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
GRAPH_DATA_DIR=./graph_data
UPLOAD_DIR=./uploads

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./deep_tutor.db
