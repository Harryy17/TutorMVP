# =============================================================================
# Indie Tutor — Comprehensive .gitignore
# =============================================================================

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template
*.env
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json

# ─── Python & Virtual Environments ───────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.pyre/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ─── Node.js / Vite / Frontend ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build outputs
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.vuepress/dist
.temp/
.cache/
.parcel-cache/
.turbo/
.oxlint-cache
.eslintcache

# ─── Database, Storage & Uploads ────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
data/
backend/data/
chroma_data/
backend/chroma_data/
graph_data/
backend/graph_data/
uploads/
backend/uploads/
!backend/uploads/.gitkeep
test_artifacts/
backend/test_artifacts/
sessions/
backend/sessions/

# ─── Logs & Temporary Files ─────────────────────────────────────────────────
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ─── IDEs & Editors ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
.project
.settings/

# ─── Operating System Files ─────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.trash
